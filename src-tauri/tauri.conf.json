{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCode Recovery",
  "version": "0.1.0",
  "identifier": "com.edison.opcrotate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenCode Recovery",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 660,
        "backgroundColor": "#202021",
        "theme": "Dark"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Edison Malasan",
    "copyright": "Copyright (c) 2026 Edison Malasan",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/edisonmalasan/opc-rotate",
    "shortDescription": "Recovery dashboard for live OpenCode sessions",
    "longDescription": "Monitor live OpenCode sessions by project and recover selected work through the separately installed SoftEther VPN Client.",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
